{
  "name": "samet-larp-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pg": "scripts/pg.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sql": "tsx scripts/apply-sql.ts",
    "db:reset": "tsx scripts/db-reset.ts && npm run db:setup",
    "db:setup": "npm run db:migrate && npm run db:sql",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.44.2",
    "jsep": "^1.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.14",
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
