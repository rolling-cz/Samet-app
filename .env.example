# Lokálně: Postgres z docker-compose.yml
DATABASE_URL="postgres://larp:larp@localhost:5433/samet_larp"

# Produkce (Neon) má dva connection stringy a nejsou zaměnitelné:
#
#   pooled — host obsahuje "-pooler", jde do Vercelu jako DATABASE_URL.
#            Je to PgBouncer v transaction módu, proto má klient prepare: false
#            (src/db/client.ts).
#   direct — host bez "-pooler", jde do GitHub secrets jako NEON_DIRECT_URL
#            a pouští se z něj migrace. DDL a `create or replace function`
#            s tělem v $$ přes pooler nepatří.
#
# Produkční string sem nepiš — odsud je to jeden omylem spuštěný `npm run db:seed`
# od smazaného ostrého běhu.
#
# DATABASE_URL="postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/samet_larp?sslmode=require"

# Jedno sdílené heslo do aplikace (§3.1). Bez něj je přihlášení vypnuté a aplikace nikoho nepustí.
APP_PASSWORD="zmen-me"
